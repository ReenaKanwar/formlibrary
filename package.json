{
  "name": "skemvora",
  "version": "1.0.1",
  "description": "Skemvora - A schema-driven React form library.",
  "license": "MIT",
  "keywords": [
    "react",
    "schema",
    "forms",
    "dynamic-forms",
    "react-library",
    "form-builder",
    "skemvora",
    "formlibrary"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ReenaKanwar/formlibrary.git"
  },
  "files": [
    "dist"
  ],
  "main": "./dist/skemvora.umd.js",
  "module": "./dist/skemvora.es.js",
  "exports": {
    ".": {
      "import": "./dist/skemvora.es.js",
      "require": "./dist/skemvora.umd.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "sideEffects": [
    "*.css"
  ],
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "vite": "^5.0.0",
    "vite-plugin-lib-inject-css": "^2.2.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "prepublishOnly": "npm run build"
  }
}